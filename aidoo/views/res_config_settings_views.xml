<odoo>

    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.aidoo</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Aidoo AI Assistant" string="Aidoo AI Assistant"
                     name="aidoo" logo="/aidoo/static/description/icon.png">

                    <block title="General" name="aidoo_general">
                        <setting string="Default AI Provider"
                                 help="Preselected when a user starts a new conversation.">
                            <field name="aidoo_default_provider"/>
                        </setting>
                        <setting string="Max Turns">
                            <field name="aidoo_max_turns"/>
                        </setting>
                        <setting string="Run Timeout (s)">
                            <field name="aidoo_timeout_s"/>
                        </setting>
                        <setting string="Max Concurrent Runs"
                                 help="Cap on AI runs executing at once across all users. 0 = unlimited.">
                            <field name="aidoo_max_concurrent_runs"/>
                        </setting>
                        <setting string="Scheduler Check Interval (minutes)"
                                 help="How often Aidoo checks for and launches due scheduled agents. Smallest effective period for a scheduled agent.">
                            <field name="aidoo_dispatch_interval_minutes"/>
                        </setting>
                        <setting string="Max Upload Size (MB)">
                            <field name="aidoo_max_upload_mb"/>
                        </setting>
                        <setting string="Odoo Host URL"
                                 help="Host URL the MCP bridge connects back to (loopback by default).">
                            <field name="aidoo_base_url"/>
                        </setting>
                        <setting string="Odoo Database"
                                 help="Database the assistant connects to. Empty = current database.">
                            <field name="aidoo_db_name" placeholder="current database"/>
                        </setting>
                    </block>

                    <block title="Claude" name="aidoo_claude">
                        <setting string="CLI Path" help="Empty = auto-detect.">
                            <field name="aidoo_claude_cli_path" placeholder="auto-detect"/>
                        </setting>
                        <setting string="Model">
                            <field name="aidoo_claude_model"/>
                        </setting>
                    </block>

                    <block title="Codex (OpenAI)" name="aidoo_codex">
                        <setting string="Model" help="Model on the ChatGPT Codex backend (gpt-5.5, gpt-5.4, gpt-5.4-mini; codex-branded ids need an API key). Empty falls back to gpt-5.5.">
                            <field name="aidoo_codex_model" placeholder="gpt-5.5"/>
                        </setting>
                        <setting string="Base URL" help="Empty = https://chatgpt.com/backend-api/codex (native, no codex binary needed).">
                            <field name="aidoo_codex_base_url" placeholder="https://chatgpt.com/backend-api/codex"/>
                        </setting>
                        <setting string="Requests/min Cap" help="Proactive cap on Codex requests per minute (per account, per worker). 0 disables.">
                            <field name="aidoo_codex_rpm_limit"/>
                        </setting>
                    </block>

                    <block title="Gemini (Google)" name="aidoo_gemini">
                        <setting string="CLI Path" help="Empty = auto-detect (PATH).">
                            <field name="aidoo_gemini_cli_path" placeholder="auto-detect"/>
                        </setting>
                        <setting string="Model">
                            <field name="aidoo_gemini_model"/>
                        </setting>
                        <setting string="Fallback Model" help="Lighter model used when the primary is rate-limited (429); separate quota bucket. Empty disables.">
                            <field name="aidoo_gemini_fallback_model" placeholder="gemini-2.5-flash"/>
                        </setting>
                        <setting string="Requests/min Cap" help="Proactive cap on Code Assist requests per minute (per project, per worker). 0 disables. Limits are also per-model.">
                            <field name="aidoo_gemini_rpm_limit"/>
                        </setting>
                        <setting string="Authentication Mode">
                            <field name="aidoo_gemini_auth_mode"/>
                        </setting>
                        <setting string="Shared Gemini API Key">
                            <field name="aidoo_gemini_api_key" password="True"/>
                        </setting>
                        <setting string="Shared Google Cloud Project">
                            <field name="aidoo_gemini_cloud_project"/>
                        </setting>
                        <setting string="Output Format">
                            <field name="aidoo_gemini_output_format"/>
                        </setting>
                    </block>

                    <block title="Grok (xAI)" name="aidoo_grok">
                        <setting string="Model">
                            <field name="aidoo_grok_model" placeholder="grok-4.7"/>
                        </setting>
                        <setting string="Authentication Mode">
                            <field name="aidoo_grok_auth_mode"/>
                        </setting>
                        <setting string="Shared xAI API Key">
                            <field name="aidoo_grok_api_key" password="True"/>
                        </setting>
                    </block>

                    <block title="Z.AI (GLM Coding Plan)" name="aidoo_zai">
                        <setting string="Model">
                            <field name="aidoo_zai_model"/>
                        </setting>
                        <setting string="Base URL" help="GLM Coding Plan endpoint (OpenAI-compatible).">
                            <field name="aidoo_zai_base_url"/>
                        </setting>
                        <setting string="Shared Z.AI API Key">
                            <field name="aidoo_zai_api_key" password="True"/>
                        </setting>
                    </block>

                    <block title="Antigravity (Google) — experimental" name="aidoo_antigravity">
                        <setting string="Enable Antigravity"
                                 help="Web tools cannot be sandboxed (ungated internet access). Do not enable for zero-trust deployments — see SECURITY.md.">
                            <field name="aidoo_antigravity_enabled"/>
                        </setting>
                        <setting string="CLI Path" help="Empty = auto-detect (PATH).">
                            <field name="aidoo_antigravity_cli_path" placeholder="auto-detect"/>
                        </setting>
                        <setting string="Model">
                            <field name="aidoo_antigravity_model"/>
                        </setting>
                    </block>

                    <block title="Tools &amp; Security" name="aidoo_security">
                        <setting string="Enable SQL Reporting Tool"
                                 help="Read-only SQL for the AI SQL Analyst group.">
                            <field name="aidoo_sql_enabled"/>
                        </setting>
                        <setting string="SQL Table Denylist"
                                 help="Table-name patterns (fnmatch globs) the SQL tool may NOT read from. Raw SQL bypasses Odoo record rules, so use this to keep sensitive tables out of reach even for AI SQL Analyst members.">
                            <field name="aidoo_sql_table_denylist"
                                   placeholder="account_*, hr_*, *_payslip"/>
                        </setting>
                        <setting string="Zero-Trust by Default (read-only)"
                                 help="When on, users left on 'Inherit' may only use read-only tools. A per-user override can still allow writes.">
                            <field name="aidoo_zero_trust_default"/>
                        </setting>
                        <setting string="Models Hidden from AI"
                                 help="The assistant refuses to introspect, read, or write these models for every user.">
                            <field name="aidoo_excluded_model_ids" widget="many2many_tags"
                                   placeholder="e.g. res.users, account.move"/>
                        </setting>
                        <setting string="AI Action Method Patterns"
                                 help="fnmatch patterns for methods orm_action/run_wizard may call. Private/dunder methods are always blocked.">
                            <field name="aidoo_action_method_patterns"
                                   placeholder="action_*,button_*"/>
                        </setting>
                        <setting string="AI-Runnable Server Actions"
                                 help="Only these server actions may be run via run_server_action. Empty = none. Code actions run arbitrary Python; allowlist only what you trust.">
                            <field name="aidoo_allowed_server_action_ids" widget="many2many_tags"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <record id="action_ai_settings" model="ir.actions.act_window">
        <field name="name">AI Assistant Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="context">{'module': 'aidoo'}</field>
    </record>

    <menuitem id="menu_ai_settings" name="Settings"
              parent="menu_ai_root" action="action_ai_settings"
              sequence="90" groups="group_ai_manager"/>

</odoo>
