<odoo>

    <record id="view_aidoo_scheduled_list" model="ir.ui.view">
        <field name="name">aidoo.scheduled.list</field>
        <field name="model">aidoo.scheduled</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="user_id"/>
                <field name="provider"/>
                <field name="interval_number"/>
                <field name="interval_type"/>
                <field name="delivery"/>
                <field name="next_run"/>
                <field name="last_run"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_aidoo_scheduled_form" model="ir.ui.view">
        <field name="name">aidoo.scheduled.form</field>
        <field name="model">aidoo.scheduled</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_run_now" type="object" string="Run Now"
                            class="btn-primary" icon="play_arrow"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                            invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Daily sales summary"/></h1>
                    </div>
                    <group>
                        <group string="Run">
                            <field name="persona_id"/>
                            <field name="user_id"/>
                            <field name="provider"/>
                            <field name="skill_ids" widget="many2many_tags"/>
                            <field name="context_mode"/>
                            <field name="context_amount"
                                   invisible="context_mode not in ('messages', 'runs')"/>
                            <field name="active"/>
                        </group>
                        <group string="Schedule">
                            <label for="interval_number" string="Every"/>
                            <div class="o_row">
                                <field name="interval_number" class="oe_inline"/>
                                <field name="interval_type" class="oe_inline"/>
                            </div>
                            <field name="next_run"/>
                            <field name="last_run"/>
                        </group>
                    </group>
                    <separator string="Prompt"/>
                    <field name="prompt" nolabel="1"
                           placeholder="What should the assistant do on each run?"/>
                    <separator string="Skill Instructions" invisible="not skill_ids"/>
                    <field name="skill_preview" nolabel="1" readonly="1"
                           invisible="not skill_ids"/>
                    <group string="Delivery">
                        <field name="delivery"/>
                        <field name="email_to" invisible="delivery != 'email'"
                               placeholder="Defaults to the run-as user's email"/>
                        <field name="res_model" invisible="delivery != 'chatter'"
                               required="delivery == 'chatter'"/>
                        <field name="res_id" invisible="delivery != 'chatter'"
                               required="delivery == 'chatter'"/>
                    </group>
                    <notebook>
                        <page string="Runs">
                            <field name="session_ids" readonly="1">
                                <list>
                                    <field name="create_date"/>
                                    <field name="name"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_aidoo_scheduled_kanban" model="ir.ui.view">
        <field name="name">aidoo.scheduled.kanban</field>
        <field name="model">aidoo.scheduled</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="next_run"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex justify-content-between align-items-start">
                            <a type="open">
                                <field name="name" class="fw-bold fs-5"/>
                            </a>
                            <span class="badge text-bg-secondary text-uppercase">
                                <field name="provider"/>
                            </span>
                        </div>
                        <div class="text-muted small mt-1">
                            <i class="oi me-1" data-icon="schedule" title="Schedule"/>Every
                            <field name="interval_number"/>
                            <field name="interval_type"/>
                        </div>
                        <div class="small mt-1">
                            <i class="oi me-1" data-icon="send" title="Delivery"/><field name="delivery"/>
                            <span class="ms-2">
                                <i class="oi me-1" data-icon="person" title="Run as"/><field name="user_id"/>
                            </span>
                        </div>
                        <div class="small text-muted mt-1"
                             t-if="record.next_run.raw_value">
                            Next: <field name="next_run"/>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_aidoo_scheduled_search" model="ir.ui.view">
        <field name="name">aidoo.scheduled.search</field>
        <field name="model">aidoo.scheduled</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="user_id"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_provider" string="Provider"
                            context="{'group_by': 'provider'}"/>
                    <filter name="group_user" string="Run As"
                            context="{'group_by': 'user_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_aidoo_scheduled" model="ir.actions.act_window">
        <field name="name">Scheduled Agents</field>
        <field name="res_model">aidoo.scheduled</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a scheduled AI agent</p>
            <p>Save a prompt that runs on a schedule and delivers its answer by
               email, to a record's chatter, or just as a conversation here.</p>
        </field>
    </record>

    <menuitem id="menu_ai_scheduled" name="Scheduled Agents"
              parent="menu_ai_root" action="action_aidoo_scheduled"
              sequence="20" groups="group_ai_user"/>

</odoo>
