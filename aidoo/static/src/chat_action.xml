<templates xml:space="preserve">

    <t t-name="aidoo.ChatAction">
        <div t-if="this.state.ready" class="o_ai_chat d-flex h-100">
            <!-- Mobile-only backdrop: tap outside the drawer to close it. -->
            <div t-if="this.state.sidebarOpen" class="o_ai_sidebar_backdrop d-md-none"
                 t-on-click="() => this.state.sidebarOpen = false"/>
            <!-- Sidebar: provider picker + conversation list. On mobile it is an
                 off-canvas drawer toggled by state.sidebarOpen. -->
            <div t-attf-class="o_ai_sidebar d-flex flex-column border-end {{ this.state.sidebarOpen ? 'o_ai_sidebar--open' : '' }}">
                <div class="p-2 border-bottom">
                    <!-- Mobile-only drawer header with a close control. -->
                    <div class="o_ai_sidebar_close d-md-none d-flex align-items-center mb-2">
                        <span class="fw-bold">Conversations</span>
                        <button class="btn btn-sm btn-link text-decoration-none ms-auto p-0"
                                title="Close" aria-label="Close"
                                t-on-click="() => this.state.sidebarOpen = false">
                            <i class="oi" data-icon="close"/>
                        </button>
                    </div>
                    <select class="form-select form-select-sm mb-2"
                            t-on-change="(ev) => this.state.selectedProvider = ev.target.value">
                        <t t-foreach="this.state.providers" t-as="p" t-key="p.code">
                            <option t-att-value="p.code" t-att-selected="p.code === this.state.selectedProvider" t-out="p.label"/>
                        </t>
                    </select>
                    <button class="btn btn-primary w-100" t-on-click="this._newSession">
                        <i class="oi me-1" data-icon="add"/> New chat
                    </button>
                    <button class="btn btn-outline-secondary btn-sm w-100 mt-1 o_ai_new_folder"
                            t-on-click="this.createFolder">
                        <i class="oi me-1" data-icon="folder"/> New folder
                    </button>
                    <div class="o_ai_search input-group input-group-sm mt-2">
                        <span class="input-group-text"><i class="oi" data-icon="search"/></span>
                        <input type="text" class="form-control"
                               placeholder="Search conversations"
                               t-att-value="this.state.searchQuery"
                               t-on-input="(ev) => this.state.searchQuery = ev.target.value"/>
                        <button t-attf-class="btn btn-outline-secondary o_ai_fav_filter {{ this.state.favoritesOnly ? 'active' : '' }}"
                                title="Show favorites only"
                                t-on-click="() => this.state.favoritesOnly = !this.state.favoritesOnly">
                            <i class="oi" t-att-class="{ 'oi-filled': this.state.favoritesOnly }" data-icon="star"/>
                        </button>
                    </div>
                </div>
                <div class="flex-grow-1 overflow-auto">
                    <t t-foreach="this.sidebarSections" t-as="sec" t-key="sec.key">
                        <div t-attf-class="o_ai_sidebar_section_header d-flex align-items-center px-2 py-1 {{ this.state.dragOver === sec.key ? 'o_ai_drop_target' : '' }}"
                             t-on-click="() => this.toggleSection(sec)"
                             t-on-dragover="(ev) => this.onSectionDragOver(ev, sec)"
                             t-on-dragleave="() => this.state.dragOver = null"
                             t-on-drop="(ev) => this.onSectionDrop(ev, sec)">
                            <i class="oi o_ai_section_caret me-1" t-att-class="{ 'o_ai_section_caret--collapsed': sec.collapsed }" data-icon="arrow_drop_down"/>
                            <i t-if="sec.folder" class="oi me-1" data-icon="folder"/>
                            <span class="o_ai_section_label text-truncate" t-out="sec.label"
                                  t-on-dblclick.stop="() => sec.folder and this.renameFolder(sec.folder)"/>
                            <span class="o_ai_section_count text-muted ms-1" t-out="sec.sessions.length"/>
                            <t t-if="sec.folder">
                                <i class="oi ms-auto o_ai_folder_action" data-icon="edit" title="Rename folder"
                                   t-on-click.stop="() => this.renameFolder(sec.folder)"/>
                                <i class="oi ms-1 o_ai_folder_action" data-icon="delete" title="Delete folder"
                                   t-on-click.stop="() => this.deleteFolder(sec.folder)"/>
                            </t>
                        </div>
                        <t t-if="!sec.collapsed">
                            <t t-foreach="sec.sessions" t-as="s" t-key="s.id">
                            <div t-attf-class="o_ai_session_item p-2 d-flex align-items-center {{ s.id === this.state.currentId ? 'active' : '' }} {{ s.id === this.state.draggingId ? 'o_ai_dragging' : '' }}"
                                 draggable="true"
                                 t-on-dragstart="(ev) => this.onSessionDragStart(ev, s)"
                                 t-on-dragend="this.onSessionDragEnd"
                                 t-on-click="() => this._openSession(s.id)">
                                <img t-if="this._provider(s.provider).icon"
                                     t-att-src="this._provider(s.provider).icon"
                                     t-att-alt="this._provider(s.provider).label"
                                     t-att-title="this._provider(s.provider).label"
                                     class="o_ai_session_icon me-2"/>
                                <i t-else="" class="oi me-2 text-muted" data-icon="chat"
                                   t-att-title="this._provider(s.provider).label"/>
                                <span class="o_ai_session_name text-truncate" t-out="s.name"/>
                                <i t-attf-class="oi o_ai_session_star ms-auto {{ s.is_favorite ? 'oi-filled o_ai_starred' : '' }}" data-icon="star"
                                   title="Favorite"
                                   t-on-click="(ev) => { ev.stopPropagation(); this._toggleFavorite(s); }"/>
                                <i class="oi o_ai_session_del ms-1" data-icon="delete"
                                   title="Delete conversation"
                                   t-on-click="(ev) => { ev.stopPropagation(); this._deleteSession(s); }"/>
                            </div>
                            </t>
                        </t>
                    </t>
                </div>
            </div>

            <!-- Main: auth gate (per provider) OR messages + composer -->
            <div class="o_ai_main d-flex flex-column flex-grow-1">

                <!-- Mobile-only top bar: opens the conversation drawer. -->
                <div class="o_ai_mobile_bar d-md-none d-flex align-items-center border-bottom px-2 py-1">
                    <button class="btn btn-sm btn-link text-decoration-none px-1"
                            title="Conversations" aria-label="Conversations"
                            t-on-click="this.toggleSidebar">
                        <i class="oi" data-icon="menu"/>
                    </button>
                    <span class="o_ai_mobile_title text-truncate ms-1 fw-bold"
                          t-out="this.currentSessionName"/>
                </div>

                <!-- Auth gate: shown until the current conversation's provider is connected -->
                <div t-if="!this.isAuthed"
                     class="o_ai_auth d-flex flex-column align-items-center justify-content-center h-100 text-center p-4">
                    <div class="o_ai_auth_card p-4">
                        <i class="oi oi-3x text-primary mb-3" data-icon="smart_toy"/>
                        <h3 class="mb-2">Connect <t t-out="this.currentProvider.label"/></h3>
                        <p class="text-muted mb-4">
                            This conversation runs on <b><t t-out="this.currentProvider.label"/></b>.
                            Connect once to start chatting.
                        </p>

                        <!-- oauth_code (Claude): open URL, paste code back -->
                        <t t-if="this.currentProvider.auth_mode === 'oauth_code'">
                            <button t-if="this.state.authStep === 'idle'"
                                    class="btn btn-primary btn-lg" t-on-click="this._startAuth">
                                <i class="oi me-2" data-icon="login"/> Login with <t t-out="this.currentProvider.label"/>
                            </button>
                            <div t-if="this.state.authStep !== 'idle'" class="text-start">
                                <p class="mb-2">
                                    1. Authorize in the tab that just opened.<br/>
                                    2. Copy the code shown and paste it below.
                                </p>
                                <div class="input-group mb-2">
                                    <input type="text" class="form-control"
                                           placeholder="Paste authorization code here"
                                           t-att-value="this.state.authCode"
                                           t-on-input="(ev) => this.state.authCode = ev.target.value"
                                           t-on-keydown="(ev) => ev.key === 'Enter' &amp;&amp; this._completeAuth()"/>
                                    <button class="btn btn-primary"
                                            t-att-disabled="this.state.authStep === 'exchanging'"
                                            t-on-click="this._completeAuth">
                                        <t t-if="this.state.authStep === 'exchanging'">Connecting…</t>
                                        <t t-else="">Connect</t>
                                    </button>
                                </div>
                                <button class="btn btn-link btn-sm p-0" t-on-click="this._startAuth">
                                    Re-open the login
                                </button>
                            </div>
                        </t>

                        <!-- device_poll (Codex): show URL + code, poll until done -->
                        <t t-if="this.currentProvider.auth_mode === 'device_poll'">
                            <button t-if="!this.state.polling"
                                    class="btn btn-primary btn-lg" t-on-click="this._startDeviceAuth">
                                <i class="oi me-2" data-icon="login"/> Login with <t t-out="this.currentProvider.label"/>
                            </button>
                            <div t-if="this.state.polling" class="text-start">
                                <p class="mb-2">
                                    1. A verification page was opened
                                    <a t-if="this.state.deviceUrl" t-att-href="this.state.deviceUrl"
                                       target="_blank" rel="noopener noreferrer">(re-open)</a>.<br/>
                                    2. Enter this code there:
                                </p>
                                <div t-if="this.state.deviceCode" class="fs-4 fw-bold mb-2"
                                     t-out="this.state.deviceCode"/>
                                <div class="text-muted">
                                    <i class="oi oi-spin me-1" data-icon="autorenew"/> Waiting for you to finish…
                                </div>
                            </div>
                        </t>

                        <!-- import_or_key (Gemini / Grok): paste creds OR API key -->
                        <t t-if="this.currentProvider.auth_mode === 'import_or_key'">
                            <div class="text-start">
                                <label class="form-label fw-bold">Import credentials</label>
                                <div t-if="this.currentProvider.auth_import_help"
                                     class="o_ai_auth_help alert alert-info py-2 px-3 mb-2 small"
                                     style="white-space: pre-line;"
                                     t-out="this.currentProvider.auth_import_help"/>
                                <textarea class="form-control mb-1" rows="4"
                                          t-att-placeholder="this.currentProvider.auth_import_placeholder"
                                          t-att-value="this.state.credsInput"
                                          t-on-input="(ev) => this.state.credsInput = ev.target.value"/>
                                <button class="btn btn-primary mb-3" t-on-click="this._submitImport">
                                    Import &amp; connect
                                </button>
                                <t t-if="this.currentProvider.auth_key">
                                    <label class="form-label fw-bold">…or use an API key</label>
                                    <div class="input-group">
                                        <input type="password" class="form-control"
                                               placeholder="Paste API key" t-att-value="this.state.apiKeyInput"
                                               t-on-input="(ev) => this.state.apiKeyInput = ev.target.value"/>
                                        <button class="btn btn-outline-primary" t-on-click="this._submitKey">
                                            Save key
                                        </button>
                                    </div>
                                </t>
                            </div>
                        </t>

                        <div t-if="this.state.authError" class="alert alert-danger mt-3 mb-0"
                             t-out="this.state.authError"/>
                    </div>
                </div>

                <!-- Chat surface (current provider connected) -->
                <t t-if="this.isAuthed">
                    <div t-if="this.state.contextLabel"
                         class="o_ai_context_chip px-3 py-2 border-bottom small text-muted">
                        <i class="oi me-1" data-icon="link"/> Discussing: <b t-out="this.state.contextLabel"/>
                    </div>
                    <AiMessageList messages="this.state.messages" running="this.state.running"
                                   hasMore="this.state.hasMore" onLoadMore.bind="this.loadMore"
                                   onOpenArtifact.bind="this.openArtifact"
                                   groups="this.state.groups"
                                   onMoveMessage.bind="this.moveMessage"
                                   onToggleGroup.bind="this.toggleGroup"
                                   onRenameGroup.bind="this.renameGroup"
                                   onCreateGroup.bind="this.createGroup"
                                   onDeleteGroup.bind="this.deleteGroup"/>
                    <div t-if="this.state.running" class="px-2 pb-1">
                        <div t-if="this.state.notice" class="small text-muted fst-italic mb-1">
                            <i class="oi me-1" data-icon="schedule"/><t t-out="this.state.notice"/>
                        </div>
                        <button class="btn btn-sm btn-link text-danger" t-on-click="this.onStop">
                            <i class="oi me-1" data-icon="stop"/> Stop
                        </button>
                    </div>
                    <AiComposer onSend.bind="this.onSend" disabled="this.state.running"
                                sessionId="this.state.currentId"
                                skills="this.state.skills" skillIds="this.state.currentSkillIds"
                                onSelectSkills.bind="this.setSkills"/>
                </t>
            </div>

            <!-- Artifact panel: rendered charts/reports, on the far right -->
            <div t-if="this.state.artifactOpen and this.state.artifact"
                 class="o_ai_artifact d-flex flex-column border-start">
                <div class="o_ai_artifact_header d-flex align-items-center px-3 py-2 border-bottom">
                    <i class="oi me-2" data-icon="show_chart"/>
                    <span class="fw-bold">Preview</span>
                    <button t-if="this.state.artifact.attachmentId and !this.state.artifact.shared"
                            class="btn btn-sm btn-link ms-auto p-0 me-2"
                            title="Copy share link" t-on-click="this.shareArtifact">
                        <i class="oi" data-icon="share"/>
                    </button>
                    <button t-if="this.state.artifact.attachmentId and this.state.artifact.shared"
                            class="btn btn-sm btn-link ms-auto p-0 me-2 text-danger"
                            title="Revoke share link" t-on-click="this.revokeArtifact">
                        <i class="oi" data-icon="link_off"/>
                    </button>
                    <button t-attf-class="btn btn-sm btn-link p-0 me-2 {{ this.state.artifact.attachmentId ? '' : 'ms-auto' }}"
                            title="Open in new tab" t-on-click="this.openArtifactNewTab">
                        <i class="oi" data-icon="open_in_new"/>
                    </button>
                    <button class="btn btn-sm btn-link p-0" title="Close"
                            t-on-click="this.closeArtifact">
                        <i class="oi" data-icon="close"/>
                    </button>
                </div>
                <div class="o_ai_artifact_body flex-grow-1 overflow-auto p-3">
                    <ReportFrame html="this.state.artifact.html" src="this.state.artifact.url"/>
                </div>
            </div>
        </div>
    </t>

</templates>
