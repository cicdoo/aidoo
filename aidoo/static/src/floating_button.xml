<templates xml:space="preserve">

    <t t-name="aidoo.FloatingButton">
      <div class="o_aidoo_root">
        <t t-if="widget.showFab()">
            <div class="o_aidoo_fab_wrap">
                <button t-attf-class="btn btn-primary rounded-circle shadow o_aidoo_fab_btn"
                        t-att-title="widget.panelOpen() ? 'Hide Aidoo' : 'Ask Aidoo'">
                    <i t-attf-class="fa #{widget.panelOpen() ? 'fa-times' : 'fa-comments'}"/>
                </button>
            </div>

            <!-- Floating chat panel (overlays the view, which stays visible) -->
            <div t-if="widget.panelOpen()"
                 t-attf-class="o_aidoo_panel d-flex flex-column shadow-lg #{widget.state.expanded ? 'o_aidoo_panel--expanded' : ''}">
                <div class="o_aidoo_panel_header d-flex align-items-center px-2 py-2">
                    <i class="fa fa-magic mr-2"/>
                    <div class="flex-grow-1 text-truncate">
                        <span class="font-weight-bold">Aidoo</span>
                        <small t-if="widget.state.contextLabel" class="ml-1 opacity-75 text-truncate">
                            · <t t-esc="widget.state.contextLabel"/>
                        </small>
                    </div>
                    <button class="btn btn-sm btn-link text-reset p-0 mr-2 o_aidoo_new" title="New chat">
                        <i class="fa fa-plus"/>
                    </button>
                    <button class="btn btn-sm btn-link text-reset p-0 mr-2 o_aidoo_expand"
                            t-att-title="widget.state.expanded ? 'Shrink' : 'Expand'">
                        <i t-attf-class="fa #{widget.state.expanded ? 'fa-compress' : 'fa-expand'}"/>
                    </button>
                    <button class="btn btn-sm btn-link text-reset p-0 mr-2 o_aidoo_min" title="Minimize">
                        <i class="fa fa-window-minimize"/>
                    </button>
                    <button class="btn btn-sm btn-link text-reset p-0 o_aidoo_close" title="Close">
                        <i class="fa fa-times"/>
                    </button>
                </div>

                <div t-if="!widget.state.ready"
                     class="flex-grow-1 d-flex align-items-center justify-content-center text-muted">
                    <i class="fa fa-spinner fa-spin mr-2"/> Loading…
                </div>

                <t t-if="widget.state.ready">
                    <div class="o_aidoo_msglist_mount d-flex flex-column flex-grow-1 overflow-hidden"/>
                    <div t-if="widget.state.authError" class="alert alert-warning m-2 p-2 small mb-0"
                         t-esc="widget.state.authError"/>
                    <div class="o_aidoo_composer_mount"/>
                </t>
            </div>
        </t>
      </div>
    </t>

</templates>
