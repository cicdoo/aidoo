<templates xml:space="preserve">

    <!-- Rendered once per message via t-call from aidoo.MessageList, with the
         message in the ``m`` variable and helpers on ``widget`` (the list). -->
    <t t-name="aidoo.Message">
        <div t-attf-class="o_ai_msg o_ai_msg_#{m.role} d-flex flex-column mb-3">
            <div class="o_ai_msg_role small text-muted mb-1">
                <t t-esc="widget.roleLabel(m)"/>
            </div>

            <!-- Tool calls: collapsed by default behind a toggle -->
            <t t-if="widget.toolCalls(m).length">
                <div class="o_ai_tools mb-1">
                    <button type="button" t-att-data-msg-id="m.id"
                            class="o_ai_tools_toggle btn btn-sm btn-link p-0 d-flex align-items-center small text-muted text-decoration-none">
                        <i t-attf-class="fa o_ai_caret #{widget.isToolsOpen(m) ? 'fa-caret-down' : 'fa-caret-right'} mr-1"/>
                        <i t-if="widget.toolsBusy(m)" class="fa fa-spinner fa-spin mr-1"/>
                        <i t-if="!widget.toolsBusy(m)" class="fa fa-wrench mr-1"/>
                        <span t-esc="widget.toolCalls(m).length + (widget.toolCalls(m).length === 1 ? ' tool call' : ' tool calls')"/>
                    </button>
                    <div t-attf-class="o_ai_tools_list mt-1 #{widget.isToolsOpen(m) ? '' : 'd-none'}">
                        <t t-foreach="widget.toolCalls(m)" t-as="call">
                            <div class="o_ai_tool_chip d-flex align-items-center small">
                                <i t-attf-class="fa #{widget.statusIcon(call)} mr-1"/>
                                <span class="font-weight-bold mr-1" t-esc="call.name"/>
                                <span class="text-muted text-truncate" t-esc="widget.summarizeInput(call)"/>
                            </div>
                        </t>
                    </div>
                </div>
            </t>

            <!-- Attachment chips (files the user attached to this turn) -->
            <t t-if="widget.attachments(m).length">
                <div class="o_ai_attachments d-flex flex-wrap mb-1">
                    <t t-foreach="widget.attachments(m)" t-as="att">
                        <div class="o_ai_attachment_chip d-flex align-items-center small mr-1">
                            <i t-attf-class="fa #{widget.attachmentIcon(att)} mr-1"/>
                            <span class="text-truncate" t-esc="att.name"/>
                        </div>
                    </t>
                </div>
            </t>

            <!-- Body: plain text for the user; otherwise ordered segments where
                 embedded HTML (e.g. a CSS/SVG chart) becomes a card that opens
                 the artifact panel, and the rest renders as markdown. -->
            <t t-if="m.body">
                <div t-if="m.role === 'user'"
                     class="o_ai_msg_body o_ai_msg_plain" t-esc="m.body"/>
                <t t-if="m.role !== 'user'">
                    <t t-foreach="widget.segments(m)" t-as="seg">
                        <button t-if="seg.type === 'html'" type="button"
                                t-att-data-msg-id="m.id" t-att-data-seg-index="seg_index"
                                class="o_ai_artifact_card d-flex align-items-center">
                            <i class="fa fa-area-chart mr-2"/>
                            <span class="font-weight-bold mr-2">Chart</span>
                            <span class="text-muted small">Click to view</span>
                            <i class="fa fa-chevron-right ml-auto"/>
                        </button>
                        <div t-if="seg.type !== 'html'"
                             class="o_ai_msg_body o_ai_md" t-raw="seg.html"/>
                    </t>
                </t>
            </t>
        </div>
    </t>

</templates>
