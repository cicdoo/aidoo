<templates xml:space="preserve">

    <t t-name="aidoo.Composer">
        <div class="o_ai_composer border-top p-2">
            <!-- Attachment chips for files queued on the next message -->
            <div t-if="this.state.files.length" class="o_ai_attachments d-flex flex-wrap gap-1 mb-2">
                <div t-foreach="this.state.files" t-as="f" t-key="f.id"
                     class="o_ai_attachment_chip d-flex align-items-center small">
                    <i class="oi me-1" data-icon="attach_file"/>
                    <span class="text-truncate" t-out="f.name"/>
                    <button class="btn btn-sm o_ai_attachment_remove ms-1 p-0"
                            title="Remove" t-on-click="() => this.removeFile(f.id)">
                        <i class="oi" data-icon="close"/>
                    </button>
                </div>
            </div>

            <div t-if="this.state.error" class="text-danger small mb-1" t-out="this.state.error"/>

            <div class="d-flex align-items-end gap-2">
                <input type="file" class="d-none" t-ref="this.fileRef" multiple="multiple"
                       accept=".txt,.csv,.tsv,.json,.xml,.md,.markdown,.rst,.log,.yaml,.yml,.ini,.conf,.cfg,.toml,.env,.py,.js,.ts,.jsx,.tsx,.html,.htm,.css,.scss,.sql,.sh,.c,.h,.cpp,.hpp,.java,.go,.rb,.php,.pdf,.png,.jpg,.jpeg,.gif,.webp,image/*,.mp3,.wav,.m4a,.ogg,.opus,.flac,.aac,.webm,audio/*"
                       t-on-change="this.onFilesChosen"/>
                <button class="btn btn-light o_ai_attach"
                        title="Attach files (text, CSV, code, PDF, images, audio)"
                        t-att-disabled="this.props.disabled || this.state.uploading"
                        t-on-click="this.pickFiles">
                    <i t-attf-class="oi {{ this.state.uploading ? 'oi-spin' : '' }}" t-att-data-icon="this.state.uploading ? 'autorenew' : 'attach_file'"/>
                </button>
                <!-- Skill picker: opens a searchable dialog. The chosen skill's
                     instructions are followed every turn in this chat. -->
                <button class="btn btn-light o_ai_skill_btn d-flex align-items-center"
                        t-att-title="this.currentSkillName ? ('Skill: ' + this.currentSkillName) : 'Pick an instruction skill'"
                        t-on-click="this.openSkillPicker">
                    <i class="oi" data-icon="wand_stars"/>
                    <span t-if="this.currentSkillName"
                          class="ms-1 d-none d-md-inline text-truncate o_ai_skill_btn_label"
                          t-out="this.currentSkillName"/>
                </button>
                <textarea t-ref="this.inputRef"
                          class="form-control o_ai_composer_input"
                          rows="1"
                          placeholder="Ask the assistant…  (Enter to send, Shift+Enter for newline)"
                          t-att-value="this.state.text"
                          t-on-keydown="this.onKeydown"
                          t-on-input="this.onInput"/>
                <button class="btn btn-primary o_ai_send"
                        t-att-disabled="!this.canSend"
                        t-on-click="this._send">
                    <i class="oi" data-icon="send"/>
                </button>
            </div>
        </div>
    </t>

</templates>
