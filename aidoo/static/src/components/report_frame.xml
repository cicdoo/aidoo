<templates xml:space="preserve">

    <t t-name="aidoo.ReportFrame">
        <iframe t-if="this.props.src" t-ref="this.frame"
                class="o_ai_report_frame o_ai_report_frame_src"
                sandbox="allow-same-origin"
                t-att-src="this.props.src" t-on-load="this.onLoad"/>
        <iframe t-else="" t-ref="this.frame" class="o_ai_report_frame"
                sandbox="allow-same-origin"
                t-att-srcdoc="this.props.html" t-on-load="this.onLoad"/>
    </t>

</templates>
