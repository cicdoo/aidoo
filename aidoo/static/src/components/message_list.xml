<templates xml:space="preserve">

    <t t-name="aidoo.MessageList">
        <div class="o_ai_message_list flex-grow-1 overflow-auto p-3">
            <t t-if="!widget.messages.length">
                <div class="o_ai_empty text-center text-muted mt-5">
                    <i class="fa fa-comments fa-3x mb-3 d-block"/>
                    <div>Ask me to query data or build a report.</div>
                </div>
            </t>
            <t t-foreach="widget.displayMessages()" t-as="msg">
                <t t-call="aidoo.Message">
                    <t t-set="m" t-value="msg"/>
                </t>
            </t>
            <div t-if="widget.running" class="o_ai_typing small text-muted">
                <i class="fa fa-spinner fa-spin mr-1"/> Assistant is working…
            </div>
        </div>
    </t>

</templates>
