<odoo noupdate="1">

    <!-- Discuss bot partner. Stable record so it exists before any Discuss usage
         and is selectable in "Add members" / @mention autocomplete. The lazy
         aidoo.session._aidoo_bot_partner() resolves this same xmlid first. -->
    <record id="partner_aidoo_bot" model="res.partner">
        <field name="name">Aidoo</field>
        <field name="email">aidoo@example.com</field>
    </record>

</odoo>
