<odoo noupdate="0">

    <record id="module_category_aidoo" model="ir.module.category">
        <field name="name">AI Assistant</field>
        <field name="sequence">90</field>
    </record>

    <!-- Odoo 19: groups are grouped under a res.groups.privilege, which carries
         the module category (the old group.category_id was removed). -->
    <record id="privilege_aidoo" model="res.groups.privilege">
        <field name="name">AI Assistant</field>
        <field name="category_id" ref="module_category_aidoo"/>
        <field name="sequence">90</field>
    </record>

    <record id="group_ai_user" model="res.groups">
        <field name="name">AI Assistant User</field>
        <field name="privilege_id" ref="privilege_aidoo"/>
        <field name="comment">Can use the AI Assistant chat.</field>
    </record>

    <record id="group_ai_sql_analyst" model="res.groups">
        <field name="name">AI SQL Analyst</field>
        <field name="privilege_id" ref="privilege_aidoo"/>
        <field name="implied_ids" eval="[(4, ref('group_ai_user'))]"/>
        <field name="comment">May run read-only SQL reports through the AI Assistant.</field>
    </record>

    <record id="group_ai_manager" model="res.groups">
        <field name="name">AI Assistant Manager</field>
        <field name="privilege_id" ref="privilege_aidoo"/>
        <field name="implied_ids" eval="[(4, ref('group_ai_sql_analyst'))]"/>
        <field name="comment">Can configure the assistant and view all audit logs.</field>
    </record>

    <!-- Grant system admins the AI groups by default. -->
    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_ai_manager'))]"/>
    </record>

    <!-- A user only sees their own conversations. -->
    <record id="rule_session_own" model="ir.rule">
        <field name="name">AI sessions: own only</field>
        <field name="model_id" ref="model_aidoo_session"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_ai_user'))]"/>
    </record>

    <!-- Managers see all sessions. -->
    <record id="rule_session_manager" model="ir.rule">
        <field name="name">AI sessions: manager all</field>
        <field name="model_id" ref="model_aidoo_session"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_ai_manager'))]"/>
    </record>

    <!-- Message groups follow their conversation's owner. -->
    <record id="rule_message_group_own" model="ir.rule">
        <field name="name">AI message groups: own only</field>
        <field name="model_id" ref="model_aidoo_message_group"/>
        <field name="domain_force">[('session_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_ai_user'))]"/>
    </record>

    <record id="rule_message_group_manager" model="ir.rule">
        <field name="name">AI message groups: manager all</field>
        <field name="model_id" ref="model_aidoo_message_group"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_ai_manager'))]"/>
    </record>

    <!-- Sidebar folders belong to one user. -->
    <record id="rule_session_folder_own" model="ir.rule">
        <field name="name">AI conversation folders: own only</field>
        <field name="model_id" ref="model_aidoo_session_folder"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_ai_user'))]"/>
    </record>

    <record id="rule_session_folder_manager" model="ir.rule">
        <field name="name">AI conversation folders: manager all</field>
        <field name="model_id" ref="model_aidoo_session_folder"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_ai_manager'))]"/>
    </record>

    <!-- A user only sees/manages their own scheduled agents. -->
    <record id="rule_scheduled_own" model="ir.rule">
        <field name="name">AI scheduled agents: own only</field>
        <field name="model_id" ref="model_aidoo_scheduled"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_ai_user'))]"/>
    </record>

    <!-- Managers see all scheduled agents. -->
    <record id="rule_scheduled_manager" model="ir.rule">
        <field name="name">AI scheduled agents: manager all</field>
        <field name="model_id" ref="model_aidoo_scheduled"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_ai_manager'))]"/>
    </record>

    <!-- Skills: a user can READ their own skills plus any shared skill… -->
    <record id="rule_skill_read" model="ir.rule">
        <field name="name">AI skills: own or shared (read)</field>
        <field name="model_id" ref="model_aidoo_skill"/>
        <field name="domain_force">['|', ('user_id', '=', user.id), ('is_shared', '=', True)]</field>
        <field name="groups" eval="[(4, ref('group_ai_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- …but only WRITE/CREATE/UNLINK their own (never another user's shared skill). -->
    <record id="rule_skill_own_write" model="ir.rule">
        <field name="name">AI skills: own only (write)</field>
        <field name="model_id" ref="model_aidoo_skill"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_ai_user'))]"/>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <!-- Managers see and manage all skills. -->
    <record id="rule_skill_manager" model="ir.rule">
        <field name="name">AI skills: manager all</field>
        <field name="model_id" ref="model_aidoo_skill"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_ai_manager'))]"/>
    </record>

    <!-- Personas: any AI user may READ active personas (needed to resolve the
         mentioned persona and build its prompt); only managers create/manage. -->
    <record id="rule_persona_read" model="ir.rule">
        <field name="name">AI personas: readable to AI users</field>
        <field name="model_id" ref="model_aidoo_persona"/>
        <field name="domain_force">[('active', '=', True)]</field>
        <field name="groups" eval="[(4, ref('group_ai_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- mail.mail is system-only in Odoo 18, but creating a mail.mail record is
         the assistant's ONE sanctioned email-send path (send tools are blocked).
         The ACL above grants AI users read+create; this rule fences reads to
         mail they queued themselves, so the outgoing mail of other users
         (password resets…) stays invisible. -->
    <record id="rule_mail_mail_ai_own" model="ir.rule">
        <field name="name">AI users: own queued outgoing mail only</field>
        <field name="model_id" ref="mail.model_mail_mail"/>
        <field name="domain_force">[('create_uid', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_ai_user'))]"/>
    </record>

    <!-- Admins imply group_ai_user (via the manager chain), so without this
         companion rule the fence above would shrink THEIR mail.mail view too. -->
    <record id="rule_mail_mail_system_all" model="ir.rule">
        <field name="name">System: all outgoing mail</field>
        <field name="model_id" ref="mail.model_mail_mail"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('base.group_system'))]"/>
    </record>

    <record id="rule_persona_manager" model="ir.rule">
        <field name="name">AI personas: manager all</field>
        <field name="model_id" ref="model_aidoo_persona"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_ai_manager'))]"/>
    </record>

</odoo>
